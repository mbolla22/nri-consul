          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "# Health Checks \u2014 Deep Dive\nPer-service and per-node breakdown of Consul health-check status (`ConsulHealthCheckSample`, one event per registered check)."
