        {
          "title": "ACL Cache Hit Rate (/min)",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT rate(sum(agent.aclCacheHit), 1 minute) FROM ConsulAgentSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "ACL Cache Miss Rate (/min)",
          "layout": {
            "column": 4,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT rate(sum(agent.aclCacheMiss), 1 minute) FROM ConsulAgentSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Max Latency (ms)",
          "layout": {
            "column": 7,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT latest(net.agent.maxLatencyInMilliseconds) FROM ConsulAgentSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "KV Store Avg (ms)",
          "layout": {
            "column": 10,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT latest(agent.kvStoresAvgInMilliseconds) FROM ConsulAgentSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Transactions & KV Ops Rate (/min)",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 6,
            "width": 6
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT rate(sum(agent.txns), 1 minute) AS 'Transactions/min', rate(sum(agent.kvStoress), 1 minute) AS 'KV Ops/min' FROM ConsulAgentSample TIMESERIES SINCE 60 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Txn & KV Avg Latency (ms)",
          "layout": {
            "column": 7,
            "height": 3,
            "row": 6,
            "width": 6
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT average(agent.txnAvgInMilliseconds) AS 'Txn Avg ms', average(agent.kvStoresAvgInMilliseconds) AS 'KV Avg ms' FROM ConsulAgentSample TIMESERIES SINCE 60 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Catalog Node Health (Aggregate)",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 9,
            "width": 6
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
