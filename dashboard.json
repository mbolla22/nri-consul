                "accountId": 1015429,
                "query": "SELECT displayName, leader, catalog.registeredNodes, catalog.passingNodes, catalog.warningNodes, catalog.criticalNodes, raft.txns, raft.commitTimeAvgInMilliseconds FROM ConsulDatacenterSample SINCE 30 minutes ago LIMIT 20"
              }
            ]
