{
  "name": "Consul Complete \u2014 Health & Metrics Dashboard",
  "description": "Full-stack Consul observability via nri-consul (this fork): agent metrics (including fixed runtime/GC telemetry), datacenter metrics, per-check health status filterable by service/node, an SLO-style uptime trend, a per-check status mosaic, and certificate-expiry telemetry mappings (Enterprise-only in practice on Consul today).",
  "permissions": "PUBLIC_READ_WRITE",
  "variables": [
    {
      "name": "serviceName",
      "title": "Service",
      "type": "NRQL",
      "isMultiSelection": true,
      "nrqlQuery": {
        "accountIds": [
          1015429
        ],
        "query": "SELECT uniques(serviceName) FROM ConsulHealthCheckSample WHERE serviceName IS NOT NULL AND serviceName != ''"
      },
      "replacementStrategy": "STRING",
      "defaultValues": [
        {
          "value": {
            "string": "auth"
          }
        },
        {
          "value": {
            "string": "billing"
          }
        },
        {
          "value": {
            "string": "cache"
          }
        },
        {
          "value": {
            "string": "gateway"
          }
        },
        {
          "value": {
            "string": "inventory"
          }
        },
        {
          "value": {
            "string": "messaging"
          }
        },
        {
          "value": {
            "string": "analytics"
          }
        },
        {
          "value": {
            "string": "notifications"
          }
        },
        {
          "value": {
            "string": "payments"
          }
        },
        {
          "value": {
            "string": "scheduler"
          }
        },
        {
          "value": {
            "string": "search"
          }
        },
        {
          "value": {
            "string": "storage"
          }
        },
        {
          "value": {
            "string": "web"
          }
        }
      ]
    },
    {
      "name": "node",
      "title": "Node",
      "type": "NRQL",
      "isMultiSelection": true,
      "nrqlQuery": {
        "accountIds": [
          1015429
        ],
        "query": "SELECT uniques(node) FROM ConsulHealthCheckSample"
      },
      "replacementStrategy": "STRING",
      "defaultValues": [
        {
          "value": {
            "string": "ip-10-10-50-192"
          }
        }
      ]
    }
  ],
  "pages": [
    {
      "name": "Overview",
      "description": "Cluster-wide health at a glance",
      "widgets": [
        {
          "title": "",
          "layout": {
            "column": 1,
            "height": 2,
            "row": 1,
            "width": 12
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "# Consul Fleet Overview\nLive health-check, agent, and cluster telemetry from `nri-consul` (custom fork with per-check visibility). Default time window: last 30 minutes."
          }
        },
        {
          "title": "Total Health Checks",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT count(*) FROM ConsulHealthCheckSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Critical Checks",
          "layout": {
            "column": 4,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT filter(count(*), WHERE check.status = 'critical') FROM ConsulHealthCheckSample SINCE 30 minutes ago"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "CRITICAL",
                "value": 1
              }
            ]
          }
        },
        {
          "title": "Warning Checks",
          "layout": {
            "column": 7,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT filter(count(*), WHERE check.status = 'warning') FROM ConsulHealthCheckSample SINCE 30 minutes ago"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 1
              }
            ]
          }
        },
        {
          "title": "Passing Checks",
          "layout": {
            "column": 10,
            "height": 3,
            "row": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT filter(count(*), WHERE check.status = 'passing') FROM ConsulHealthCheckSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Cluster Health Score (% passing)",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 6,
            "width": 4
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT percentage(count(*), WHERE check.status = 'passing') FROM ConsulHealthCheckSample SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Registered Nodes",
          "layout": {
            "column": 5,
            "height": 3,
            "row": 6,
            "width": 4
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT latest(catalog.registeredNodes) FROM ConsulDatacenterSample SINCE 60 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Raft Peers",
          "layout": {
            "column": 9,
            "height": 3,
            "row": 6,
            "width": 4
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT latest(agent.peers) FROM ConsulAgentSample SINCE 60 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Check Status Distribution",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 9,
            "width": 6
          },
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT count(*) FROM ConsulHealthCheckSample FACET check.status SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Check Status Over Time",
          "layout": {
            "column": 7,
            "height": 3,
            "row": 9,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT count(*) FROM ConsulHealthCheckSample FACET check.status TIMESERIES SINCE 60 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Checks Needing Attention (non-passing, most severe first)",
          "layout": {
            "column": 1,
            "height": 4,
            "row": 12,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT node, serviceName, checkName, check.status, check.output FROM ConsulHealthCheckSample WHERE check.statusCode > 0 SINCE 30 minutes ago ORDER BY check.statusCode DESC LIMIT 50"
              }
            ]
          }
        },
        {
          "title": "Cluster Health Trend \u2014 % Passing (SLO-style)",
          "layout": {
            "column": 1,
            "height": 3,
            "row": 16,
            "width": 6
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT percentage(count(*), WHERE check.status = 'passing') FROM ConsulHealthCheckSample TIMESERIES SINCE 3 hours ago"
              }
            ]
          }
        },
        {
          "title": "Checks by Service (filtered by Service/Node variables above)",
          "layout": {
            "column": 7,
            "height": 3,
            "row": 16,
            "width": 6
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT node, serviceName, checkName, check.status FROM ConsulHealthCheckSample WHERE serviceName IN ({{serviceName}}) OR serviceName = '' SINCE 30 minutes ago LIMIT 50"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Health Checks",
      "description": "Per-check, per-service, per-node detail",
      "widgets": [
