          }
        },
        {
          "title": "Status Code Trend by Check (0=passing, 1=warning, 2=critical, 3=maintenance)",
          "layout": {
            "column": 1,
            "height": 4,
            "row": 9,
            "width": 12
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT average(check.statusCode) FROM ConsulHealthCheckSample FACET checkName TIMESERIES SINCE 60 minutes ago LIMIT 10"
              }
            ]
          }
        },
