          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT rate(sum(raft.txns), 1 minute) FROM ConsulDatacenterSample TIMESERIES SINCE 60 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Datacenter Snapshot",
          "layout": {
            "column": 1,
            "height": 4,
            "row": 12,
            "width": 12
          },
          "visualization": {
