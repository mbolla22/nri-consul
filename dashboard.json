        {
          "title": "All Checks by Node",
          "layout": {
            "column": 7,
            "height": 3,
            "row": 6,
            "width": 6
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT count(*) FROM ConsulHealthCheckSample FACET node SINCE 30 minutes ago LIMIT 15"
              }
