          "title": "All Health Checks \u2014 Full Detail",
          "layout": {
            "column": 1,
            "height": 4,
            "row": 13,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1015429,
                "query": "SELECT node, checkID, checkName, serviceID, serviceName, check.status, check.statusCode, check.output FROM ConsulHealthCheckSample SINCE 30 minutes ago LIMIT 100"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Agent & Cluster Metrics",
      "description": "Core agent and datacenter telemetry",
      "widgets": [
        {
          "title": "",
          "layout": {
            "column": 1,
            "height": 2,
            "row": 1,
            "width": 12
          },
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "# Agent & Datacenter Telemetry\nCore `ConsulAgentSample` / `ConsulDatacenterSample` metrics \u2014 the original nri-consul coverage, unchanged by this fork."
